<%- include('partials/header') %>

<main>
    <h1> <%= title %> </h1>
    <form action="/edit-project/<%= project.project_id %>" method ="POST">
        <div class="form-group">
            <label for="name">Project Name</label>
            <input
            type="text"
            id="name"
            name="title"
            value="<% project.name %>"
            required
            maxlength="150"
            />
        </div>

        <div class="form-group">
            <label for="description">Project Description</label>
            <textarea
            id="descriptio"
            name="description"
            required
            maxlength="500"
            ><%= project.description || '' %>
        </textarea>
        </div>

        <div>
        <label for="date">Date</label>
        <input
            type="date"
            id="date"
            name="date"
            value="<%= project.date ? new Date(project.date).toISOString().split('T')[0] : '' %>"
            required
        >
    </div>

    <div>
        <label for="location">Location</label>
        <input
            type="text"
            id="location"
            name="location"
            value="<%= project.location || '' %>"
            required
        >
    </div>
    
    <div class="form-group">
    <label for="organizationId">Project Organization</label>
    <select
        id="organizationId"
        name="organizationId"
        required
    >
        <option value="">Select an organization</option>
        <% organizations.forEach(organization => { %>
            <option
                value="<%= organization.organization_id %>"
                <%= String(organization.organization_id) === String(project.organization_id) ? 'selected' : '' %>
            >
                <%= organization.name %>
            </option>
        <% }); %>
    </select>
</div>
</main>