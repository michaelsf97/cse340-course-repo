<%- include('partials/header') %>

<main>
    <h1>Upcoming Service Projects</h1>

    <p>Here you can explore the most recent projects we developed.</p>

    <div class="project-grid">

        <% if (projects && projects.length > 0) { %>

            <% projects.forEach(project => { %>
            <article class="project-card">
                <a href="/project/<%= project.project_id %>" class="project-card-link">
                    <img src="/images/<%= project.image_filename %>" alt="<%= project.name %>">
                    <div class="project-card-content">
                <h3><%= project.name %></h3>
                <p><%= project.description %></p>
                <span>Explore &rarr;</span>
            </div>
        </a>
    

             <p><a href="/organization/<%= project.organization_id %>">View Organization</a></p>
    </article>

            <% }) %>
            <% } else { %>
                <p> No projects available. </p>
                <% } %>
     </div>
</main>
           

<%- include('partials/footer') %>