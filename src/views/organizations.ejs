<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <p>Here are a few of our partner organizations:</p>
    <ul>
        <% organizations.forEach(organization => { %>
            <li><img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo"><strong><%= organization.name %></strong>: <%= organization.contact_email %></li>
            <% }); %>
    </ul>
    <img class="main-logo" src="/images/sud97.png" alt="CSE340 SUD97 Logo">
    <img class="main-logo" src="/images/UnitedNations97.png" alt="CSE340 United Nations Logo">
    <img class="main-logo" src="/images/unicef97.png" alt="CSE340 United For Every Child">
        <li><img class="main-logo" src="/images/brightfuture-logo.png" alt="BrightFuture Builders logo"><strong>BrightFuture Builders</strong>: info@brightfuture.org</li>
        <li><img class="main-logo" src="/images/greenharvest-logo.png" alt="Green Harvest Growers logo"><strong>GreenHarvest Growers</strong>: info@greenharvest.org</li>
        <li><img class="main-logo" src="/images/unityserve-logo.png" alt="UnityServe Volunteers logo"><strong>UnityServe Volunteers</strong>: info@unityserve.org</li>
</main>

<%- include('partials/footer') %>