<%- include('partials/header') %>

<h1> <%= title %> </h1>

<p>Login Form</p>

<form action="/login" method="POST">
    <div class="form-group">
        <label for="email">Email:</label>
        <input
        type="email"
        id="email"
        name="email"
        >
    </div>

    <div class="form-group">
        <label for="password">
            <input
            type="password"
            id="password"
            name="password"
            >
        </label>
    </div>

    <button type="submit">Log In</button>
</form>