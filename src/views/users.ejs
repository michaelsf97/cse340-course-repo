<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <% if (usersList && usersList.length > 0) { %>
        <table>
            <thead>
                <tr>
                    <th>Name:</th>
                    <th>Email:</th>
                    <th>Role:</th>
                </tr>
            </thead>

            <tbody>
                <% usersList.forEach((member) => { %>
                    <tr>
                        <td><%= member.name %></td>
                        <td><%= member.email %></td>
                        <td><%= member.role_name %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <p>No registered users available or found.</p>
    <% } %>
</main>

<%- include('partials/footer') %>